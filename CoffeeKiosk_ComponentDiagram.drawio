<mxfile host="drawio"><diagram id="lab3" name="Component Diagram"><mxGraphModel dx="1400" dy="960" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b style=&quot;font-size:18px&quot;&gt;Self-Service Coffee Kiosk &amp;ndash; UML Component Diagram (Layered Architecture)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;SE Lab 3 &amp;middot; Sai Nikitha Perumalla &amp;middot; PES2UG24AM142 &amp;middot; 5B AIML&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1320" height="50" as="geometry"/></mxCell><mxCell id="c12" value="Layer 1 &amp;ndash; Presentation (customer-facing)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F3F8FE;strokeColor=#8A96A3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#3A4652;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1320" height="175" as="geometry"/></mxCell><mxCell id="c13" value="Layer 2 &amp;ndash; Business Logic" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F4FBF4;strokeColor=#8A96A3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#3A4652;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="1320" height="210" as="geometry"/></mxCell><mxCell id="c14" value="Layer 3 &amp;ndash; Data &amp;amp; Hardware Access" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FEF9F0;strokeColor=#8A96A3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#3A4652;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1320" height="225" as="geometry"/></mxCell><mxCell id="c15" value="External hardware &amp;amp; services (outside the kiosk software)" style="r